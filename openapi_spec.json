{
  "openapi": "3.1.0",
  "info": {
    "title": "Pedigree Risk Calculator API",
    "description": "Prototype audit API plus deterministic Mendelian recurrence probabilities from known parental genotypes. Not validated for clinical decisions.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return basic JSON process counters",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock response (no external model inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/risk": {
      "post": {
        "summary": "Calculate known-genotype Mendelian recurrence probabilities",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "inheritance": {
                    "type": "string",
                    "enum": [
                      "autosomal_dominant",
                      "autosomal_recessive",
                      "x_linked_dominant",
                      "x_linked_recessive"
                    ]
                  },
                  "mother": {
                    "type": "string"
                  },
                  "father": {
                    "type": "string"
                  }
                },
                "required": [
                  "inheritance",
                  "mother",
                  "father"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sex-stratified genotype probabilities and affected/unaffected distributions"
          },
          "422": {
            "description": "Invalid inheritance pattern or parental genotypes"
          }
        }
      }
    }
  }
}
